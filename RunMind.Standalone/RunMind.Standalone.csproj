<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <AssemblyName>RunMind</AssemblyName>
    <AssemblyTitle>RunMind</AssemblyTitle>
    <Product>RunMind</Product>
    <ApplicationIcon>..\Assets\Brand\Icon.ico</ApplicationIcon>
    <RootNamespace>RunMind.Standalone</RootNamespace>
    <Version>1.10.15</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Shared\ConversationSaveDialog.cs" Link="Shared\ConversationSaveDialog.cs" />
    <Compile Include="..\Shared\WebView2RuntimeBootstrapper.cs" Link="Shared\WebView2RuntimeBootstrapper.cs" />
    <Compile Include="..\Shared\WindowLayout.cs" Link="Shared\WindowLayout.cs" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="..\Community.PowerToys.Run.Plugin.RunMind\ChatWindow.html" Link="ChatWindow.html" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\Assets\Brand\Icon.ico" Link="Assets\Brand\Icon.ico" />
    <Content Include="..\Assets\Brand\Icon.ico" Link="Assets\Brand\Icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Brand\Icon.svg" Link="Assets\Brand\Icon.svg" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Vendor\**\*.*" Link="Vendor\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\OCR\tessdata\**\*.*" Link="OCR\tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
