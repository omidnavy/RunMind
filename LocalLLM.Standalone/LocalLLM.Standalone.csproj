<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <AssemblyName>LocalLLM</AssemblyName>
    <ApplicationIcon>..\Assets\Brand\Icon.ico</ApplicationIcon>
    <RootNamespace>LocalLLM.Standalone</RootNamespace>
    <Version>1.6.5</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <Content Include="..\Community.PowerToys.Run.Plugin.LocalLLM\ChatWindow.html" Link="ChatWindow.html" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="..\Assets\Brand\Icon.ico" Link="Assets\Brand\Icon.ico" />
    <Content Include="..\Assets\Brand\Icon.ico" Link="Assets\Brand\Icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Assets\Brand\Icon.svg" Link="Assets\Brand\Icon.svg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
