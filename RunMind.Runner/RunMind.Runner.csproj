<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <AssemblyName>RunMind.Runner</AssemblyName>
    <AssemblyTitle>RunMind Runner</AssemblyTitle>
    <Product>RunMind</Product>
    <ApplicationIcon>..\Assets\Brand\Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RunMind.Runner</RootNamespace>
    <Version>3.4.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Exclude retired Runner chat artifacts left behind by in-place source extraction. -->
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);RunnerChatWindow.xaml;RunnerChatWindow.xaml.cs</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>
  <ItemGroup>
    <!-- Defense in depth: these files were removed when chat moved back to Standalone. -->
    <Page Remove="RunnerChatWindow.xaml" />
    <Compile Remove="RunnerChatWindow.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\Shared\AppearancePreferences.cs" Link="Shared\AppearancePreferences.cs" />
    <Compile Include="..\Shared\ThemeCatalog.cs" Link="Shared\ThemeCatalog.cs" />
    <Compile Include="..\Shared\WindowThemeSynchronizer.cs" Link="Shared\WindowThemeSynchronizer.cs" />
    <Content Include="..\Shared\ChatWindow\theme\*.css" Link="ChatWindow\theme\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="..\Shared\RunnerHandoff.cs" Link="Shared\RunnerHandoff.cs" />
    <Resource Include="..\Assets\Brand\Icon.ico" Link="Assets\Brand\Icon.ico" />
    <Content Include="..\Assets\Brand\Icon.ico" Link="Assets\Brand\Icon.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Assets\Brand\64x64.png" Link="Assets\Brand\64x64.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
