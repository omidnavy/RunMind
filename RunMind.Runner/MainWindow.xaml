<Window x:Class="RunMind.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunMind Runner"
        Width="760" Height="520" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
  <Border Background="#151A24" BorderBrush="#344052" BorderThickness="1" CornerRadius="18">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="18" />
        <RowDefinition Height="72" />
        <RowDefinition Height="14" />
        <RowDefinition Height="*" />
        <RowDefinition Height="24" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="36" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="30" Height="30" Source="pack://siteoforigin:,,,/Assets/Brand/64x64.png" Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="RUNMIND" FontSize="12" FontWeight="Bold" Foreground="#DCE6F3" />
          <TextBlock Text="RUNNER" FontSize="10" Foreground="#8291A7" />
        </StackPanel>
        <Button Grid.Column="2" Content="Settings" Click="Settings_Click" Padding="13,6" Margin="0,0,8,0"
                Background="#202A39" Foreground="#C9D5E5" BorderBrush="#3A485D" BorderThickness="1" />
        <Button Grid.Column="3" Content="×" Click="Hide_Click" FontSize="20" Padding="0,-3,0,0"
                Background="Transparent" Foreground="#9EACC0" BorderThickness="0" />
      </Grid>

      <TextBlock Grid.Row="1" Text="Find an app, open a location, or jump to a website"
                 Foreground="#8493A8" FontSize="12" VerticalAlignment="Center" />

      <Border Grid.Row="2" Background="#202A39" BorderBrush="#4C607B" BorderThickness="1" CornerRadius="12" Padding="16,0">
        <Grid>
          <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" FontSize="21"
                   Background="Transparent" Foreground="#F0F5FC" CaretBrush="#76A9FA"
                   BorderThickness="0" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                   ToolTip="Search apps, enter a folder or file path, or paste an HTTP/HTTPS URL" />
          <TextBlock x:Name="SearchPlaceholder" Text="Search apps, paths and URLs…"
                     Foreground="#708099" FontSize="21" VerticalAlignment="Center"
                     IsHitTestVisible="False" />
        </Grid>
      </Border>

      <Border Grid.Row="4" Background="#1B2330" BorderBrush="#2B3749" BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid>
          <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                   Foreground="#E4ECF7" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   MouseDoubleClick="ResultsList_MouseDoubleClick" KeyDown="ResultsList_KeyDown">
            <ListBox.Resources>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#E4ECF7" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="ItemBorder" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="#2D405A" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="ItemBorder" Property="Background" Value="#273548" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="28" Height="28" CornerRadius="8" Background="#35465E" VerticalAlignment="Center">
                    <TextBlock Text="↗" Foreground="#BFD5F4" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="#EAF1FA" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="#8D9DB2" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="Enter ↵" FontSize="10" Foreground="#77869B" VerticalAlignment="Center" Margin="10,0,2,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyTitle" Text="Your shortcuts, one keystroke away" Foreground="#A8B7CB" FontSize="14" HorizontalAlignment="Center" />
            <TextBlock x:Name="EmptyDescription" Text="Start typing to find an installed application" Foreground="#728198" FontSize="12" Margin="0,7,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="5" Margin="2,8,2,0">
        <TextBlock x:Name="StatusText" Text="Esc to close  ·  Enter to open  ·  Ctrl+Alt+Space to summon"
                   Foreground="#74849A" FontSize="10" VerticalAlignment="Center" />
        <TextBlock Text="OPTIONAL QUICK LAUNCHER" Foreground="#53647B" FontSize="9"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Grid>
  </Border>
</Window>
