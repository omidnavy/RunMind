<Window x:Class="RunMind.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RunMind Runner" Width="680" Height="340" MinWidth="520" MinHeight="184"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="{DynamicResource RunnerBackground}" ShowInTaskbar="False" Topmost="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="8" CornerRadius="14"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource RunnerBackground}" BorderBrush="{DynamicResource RunnerBorder}" BorderThickness="1" CornerRadius="18" SnapsToDevicePixels="True">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="38" />
        <RowDefinition Height="8" />
        <RowDefinition Height="54" />
        <RowDefinition Height="10" />
        <RowDefinition Height="*" />
        <RowDefinition Height="22" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="28" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="28" Height="28" Source="pack://siteoforigin:,,,/Assets/Brand/64x64.png" Stretch="Uniform" />
        <TextBlock Grid.Column="1" Text="RUNMIND" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RunnerText}" VerticalAlignment="Center" />
        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Content="Open chat" Click="Chat_Click" Margin="0,0,8,0" Padding="13,7" />
        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="3" Content="Settings" Click="Settings_Click" Margin="0,0,8,0" Padding="13,7" />
        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="4" Content="×" Click="Hide_Click" FontSize="20" Padding="0,-3,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RunnerMuted}" />
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource RunnerInput}" BorderBrush="{DynamicResource RunnerBorder}" BorderThickness="1" CornerRadius="11" Padding="14,0" SnapsToDevicePixels="True">
        <Grid>
          <TextBox x:Name="SearchBox" Height="40" MinHeight="40" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="17"
                   Foreground="{DynamicResource RunnerText}" CaretBrush="{DynamicResource RunnerAccent}"
                   SelectionBrush="{DynamicResource RunnerAccent}" SelectionTextBrush="{DynamicResource RunnerAccentContrast}"
                   Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                   TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                   TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                   ToolTip="Search apps, files, folders, URLs and calculations, or ask RunMind" />
          <TextBlock x:Name="SearchPlaceholder" Text="Search anything…" Margin="0" Foreground="{DynamicResource RunnerMuted}" Opacity="0.72" FontSize="17" VerticalAlignment="Center" IsHitTestVisible="False" />
        </Grid>
      </Border>

      <Border x:Name="ResultsPanel" Grid.Row="4" Background="{DynamicResource RunnerSurface}" BorderBrush="{DynamicResource RunnerBorder}" BorderThickness="1" CornerRadius="12" Padding="8" Visibility="Collapsed">
        <Grid>
          <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RunnerText}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="ResultsList_MouseDoubleClick"
                   KeyDown="ResultsList_KeyDown" SelectionChanged="ResultsList_SelectionChanged" Visibility="Collapsed">
            <ListBox.Resources>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,11" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource RunnerText}" />
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RunnerSurfaceHover}" /></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RunnerSurfaceRaised}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource RunnerSurfaceRaised}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource RunnerText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource RunnerMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="↵" Foreground="{DynamicResource RunnerMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0" />
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>

          <StackPanel x:Name="EmptyState" IsHitTestVisible="True" VerticalAlignment="Center" Margin="12,8">
            <TextBlock Text="Try something" Foreground="{DynamicResource RunnerText}" FontSize="13" FontWeight="SemiBold" />
            <WrapPanel Margin="0,9,0,0" ItemWidth="150">
              <Button Content="Find an app  ·  notepad" Tag="notepad" Click="Suggestion_Click" Height="34" Margin="0,0,8,8" Padding="10,5" />
              <Button Content="Calculate  ·  12 × 8" Tag="12 * 8" Click="Suggestion_Click" Height="34" Margin="0,0,8,8" Padding="10,5" />
              <Button Content="Ask RunMind" Tag="__runmind_suggestion__" Click="Suggestion_Click" Height="34" Margin="0,0,8,8" Padding="10,5" />
              <Button Content="Open a website" Tag="https://example.com" Click="Suggestion_Click" Height="34" Margin="0,0,8,8" Padding="10,5" />
            </WrapPanel>
            <TextBlock Text="Type to search, or choose a quick start." Foreground="{DynamicResource RunnerMuted}" FontSize="10" Margin="0,1,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="5" Visibility="Collapsed">
        <TextBlock x:Name="InlineStatusText"/><TextBlock x:Name="InlineAnswerText"/><ScrollViewer x:Name="InlineAnswerScroll"/>
        <TextBlock x:Name="InlineModelText"/><Button x:Name="CopyAnswerButton"/><Button x:Name="StopButton"/>
      </StackPanel>
      <TextBlock Grid.Row="5" x:Name="StatusText" Text="Esc to hide  ·  ↑↓ navigate  ·  Enter to open  ·  Ctrl+Alt+Space to summon" Foreground="{DynamicResource RunnerMuted}" FontSize="10" VerticalAlignment="Center" />
    </Grid>
  </Border>
</Window>
