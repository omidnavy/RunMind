<Window x:Class="RunMind.Runner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RunMind Runner" Width="760" Height="310" MinWidth="560" MinHeight="190"
        WindowStartupLocation="Manual" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False" Background="{DynamicResource RunnerBackground}" ShowInTaskbar="False" Topmost="True"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="8" CornerRadius="14"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Border Background="{DynamicResource RunnerBackground}" BorderBrush="{DynamicResource RunnerBorder}" BorderThickness="1" CornerRadius="18" SnapsToDevicePixels="True">
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="42" />
        <RowDefinition Height="16" />
        <RowDefinition Height="68" />
        <RowDefinition Height="16" />
        <RowDefinition Height="*" />
        <RowDefinition Height="30" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="38" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="32" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="29" Height="29" Source="pack://siteoforigin:,,,/Assets/Brand/64x64.png" Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="RUNMIND" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RunnerText}" />
          <TextBlock Text="RUNNER · QUICK AI" FontSize="9" Foreground="{DynamicResource RunnerMuted}" />
        </StackPanel>
        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="2" Content="Open chat" Click="Chat_Click" Margin="0,0,8,0" Padding="13,7" />
        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="3" Content="Settings" Click="Settings_Click" Margin="0,0,8,0" Padding="13,7" />
        <Button shell:WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="4" Content="×" Click="Hide_Click" FontSize="20" Padding="0,-3,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RunnerMuted}" />
      </Grid>

      <TextBlock Grid.Row="1" Text="One search · Applications · Files · URLs · Calculator · RunMind" Foreground="{DynamicResource RunnerMuted}" FontSize="12" VerticalAlignment="Center" />

      <Border Grid.Row="2" Background="{DynamicResource RunnerInput}" BorderBrush="{DynamicResource RunnerBorder}" BorderThickness="1" CornerRadius="12" Padding="16,0" SnapsToDevicePixels="True">
        <Grid>
          <TextBox x:Name="SearchBox" Height="52" MinHeight="52" VerticalContentAlignment="Center" VerticalAlignment="Center" FontSize="21"
                   Foreground="{DynamicResource RunnerText}" CaretBrush="{DynamicResource RunnerAccent}"
                   SelectionBrush="{DynamicResource RunnerAccent}" SelectionTextBrush="{DynamicResource RunnerAccentContrast}"
                   Background="Transparent" BorderThickness="0" Padding="0" FocusVisualStyle="{x:Null}"
                   TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
                   TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"
                   ToolTip="Search apps, enter a file or folder path, paste a URL, calculate, or use the RunMind keyword" />
          <TextBlock x:Name="SearchPlaceholder" Text="Search RunMind…" Foreground="{DynamicResource RunnerMuted}" Opacity="0.72" FontSize="21" VerticalAlignment="Center" IsHitTestVisible="False" />
          <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource RunnerSurfaceRaised}" CornerRadius="6" Padding="7,4" Margin="0,0,0,0">
            <TextBlock Text="RUNMIND  ↵" Foreground="{DynamicResource RunnerMuted}" FontSize="9" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Row="4" Background="{DynamicResource RunnerSurface}" BorderBrush="{DynamicResource RunnerBorder}" BorderThickness="1" CornerRadius="12" Padding="8">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="8,0,8,4">
            <TextBlock Text="RESULTS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" />
            <TextBlock x:Name="ResultCountText" Text="Ready" FontSize="10" Foreground="{DynamicResource RunnerMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <ListBox x:Name="ResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RunnerText}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="ResultsList_MouseDoubleClick"
                   KeyDown="ResultsList_KeyDown" SelectionChanged="ResultsList_SelectionChanged">
            <ListBox.Resources>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="12,11" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource RunnerText}" />
                <Setter Property="Template"><Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                      <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RunnerSurfaceHover}" /></Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource RunnerSurfaceRaised}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value></Setter>
              </Style>
            </ListBox.Resources>
            <ListBox.ItemTemplate><DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource RunnerSurfaceRaised}" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource RunnerText}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource RunnerMuted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="↵" Foreground="{DynamicResource RunnerMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,4,0" />
              </Grid>
            </DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyState" Grid.Row="1" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18">
            <TextBlock Text="Ready when you are" Foreground="{DynamicResource RunnerText}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="Search apps, files, folders, URLs or calculations. RunMind can answer globally or with your chosen keyword." Foreground="{DynamicResource RunnerMuted}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel Grid.Row="5" Visibility="Collapsed">
        <TextBlock x:Name="InlineStatusText"/><TextBlock x:Name="InlineAnswerText"/><ScrollViewer x:Name="InlineAnswerScroll"/>
        <TextBlock x:Name="InlineModelText"/><Button x:Name="CopyAnswerButton"/><Button x:Name="StopButton"/>
      </StackPanel>
      <Grid Grid.Row="5" Margin="2,8,2,0">
        <TextBlock x:Name="StatusText" Text="Esc to hide  ·  ↑↓ navigate  ·  Enter to open  ·  Ctrl+Alt+Space to summon" Foreground="{DynamicResource RunnerMuted}" FontSize="10" VerticalAlignment="Center" />
        <TextBlock Text="PLUGINS · LOCAL FIRST" Foreground="{DynamicResource RunnerMuted}" Opacity="0.7" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Grid>
  </Border>
</Window>
