<Window x:Class="RunMind.Runner.RunnerChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="RunMind Chat" Width="1180" Height="850" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource RunnerBackground}"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <wv2:WebView2 x:Name="ChatWebView" DefaultBackgroundColor="#171613" AllowExternalDrop="False" />
    <Border x:Name="LoadingOverlay" Background="{DynamicResource RunnerBackground}" Opacity="0.98">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560" Margin="32">
        <TextBlock Text="RUNMIND" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RunnerAccent}" HorizontalAlignment="Center" />
        <TextBlock x:Name="LoadingText" Text="Preparing RunMind chat…" FontSize="16" Foreground="{DynamicResource RunnerText}" Margin="0,12,0,0" HorizontalAlignment="Center" />
        <TextBlock x:Name="LoadingDetail" Text="The chat interface is initialized only when you open it." FontSize="11" Foreground="{DynamicResource RunnerMuted}" Margin="0,7,0,0" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
