<Window x:Class="RunMind.Runner.RunnerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunMind Runner Settings" Width="780" Height="800" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{DynamicResource RunnerBackground}" Foreground="{DynamicResource RunnerText}">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0">
      <TextBlock Text="Runner settings" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource RunnerText}" />
      <TextBlock Text="Configure this optional RunMind host independently from PowerToys Run and Command Palette." FontSize="12" Foreground="{DynamicResource RunnerMuted}" Margin="0,5,0,0" />
    </StackPanel>
    <TabControl Grid.Row="2" Background="{DynamicResource RunnerBackground}" BorderBrush="{DynamicResource RunnerBorder}" Foreground="{DynamicResource RunnerText}">
      <TabItem Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="Launcher" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock Text="Global shortcut" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,0,0,5" />
            <TextBox x:Name="HotkeyBox" Width="260" HorizontalAlignment="Left" />
            <TextBlock Text="Example: Ctrl+Alt+Space. Use at least one modifier key." Foreground="{DynamicResource RunnerMuted}" FontSize="10" Margin="0,5,0,12" />
            <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start RunMind Runner when I sign in (minimized to tray)" />
            <Separator Margin="0,14,0,14" Background="{DynamicResource RunnerBorder}" />
            <TextBlock Text="Launcher plugins" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Text="Enable the search providers shown in Runner. RunMind is the inline AI answer plugin." Foreground="{DynamicResource RunnerMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
            <CheckBox x:Name="ApplicationsPluginCheck" Content="Applications · Start Menu app search" />
            <CheckBox x:Name="FilesPluginCheck" Content="Files &amp; Folders · Open safe local files and folders" />
            <CheckBox x:Name="UrlsPluginCheck" Content="URLs · Open HTTP and HTTPS addresses" />
            <CheckBox x:Name="CalculatorPluginCheck" Content="Calculator · Safe local arithmetic" />
            <CheckBox x:Name="RunMindPluginCheck" Content="RunMind · Inline answers from Ollama or LM Studio" />
            <Separator Margin="0,14,0,14" Background="{DynamicResource RunnerBorder}" />
            <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Mode" VerticalAlignment="Center" Foreground="{DynamicResource RunnerMuted}" />
              <ComboBox x:Name="AppearanceModeBox" Grid.Row="0" Grid.Column="1" Width="230" HorizontalAlignment="Left"><ComboBoxItem Content="System" Tag="system"/><ComboBoxItem Content="Light" Tag="light"/><ComboBoxItem Content="Dark" Tag="dark"/></ComboBox>
              <TextBlock Grid.Row="1" Text="Light theme" VerticalAlignment="Center" Foreground="{DynamicResource RunnerMuted}" Margin="0,10,0,0" />
              <ComboBox x:Name="LightThemeBox" Grid.Row="1" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Name" />
              <TextBlock Grid.Row="2" Text="Dark theme" VerticalAlignment="Center" Foreground="{DynamicResource RunnerMuted}" Margin="0,10,0,0" />
              <ComboBox x:Name="DarkThemeBox" Grid.Row="2" Grid.Column="1" Width="300" HorizontalAlignment="Left" Margin="0,10,0,0" DisplayMemberPath="Name" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Inline model">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="RunMind inline provider" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="Activate inline answers with llm &lt;prompt&gt;. This provider is used only by the RunMind launcher plugin. Full chat-window provider connections remain separate." FontSize="11" Foreground="{DynamicResource RunnerMuted}" TextWrapping="Wrap" Margin="0,5,0,12" />
            <CheckBox x:Name="InlineEnabledCheck" Content="Enable inline model answers" />
            <TextBlock Text="Provider" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,10,0,5" />
            <ComboBox x:Name="ProviderBox" Width="260" HorizontalAlignment="Left" SelectionChanged="ProviderBox_SelectionChanged"><ComboBoxItem Content="Ollama" Tag="ollama"/><ComboBoxItem Content="LM Studio" Tag="lmstudio"/></ComboBox>
            <TextBlock Text="Ollama full generate endpoint" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,12,0,5" />
            <TextBox x:Name="OllamaEndpointBox" />
            <TextBlock Text="Ollama API key (optional)" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,10,0,5" />
            <PasswordBox x:Name="OllamaApiKeyBox" ToolTip="Leave empty to keep the saved credential unchanged." />
            <TextBlock Text="Ollama custom auth header (optional) · Header-Name: value" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,10,0,5" />
            <PasswordBox x:Name="OllamaAuthHeaderBox" />
            <CheckBox x:Name="ClearOllamaCredentialsCheck" Content="Clear saved Ollama credentials" />
            <Separator Margin="0,14,0,14" Background="{DynamicResource RunnerBorder}" />
            <TextBlock Text="LM Studio base URL" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,0,0,5" />
            <TextBox x:Name="LMStudioBaseUrlBox" />
            <TextBlock Text="LM Studio API key (optional)" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,10,0,5" />
            <PasswordBox x:Name="LMStudioApiKeyBox" />
            <TextBlock Text="LM Studio custom auth header (optional) · Header-Name: value" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,10,0,5" />
            <PasswordBox x:Name="LMStudioAuthHeaderBox" />
            <CheckBox x:Name="ClearLMStudioCredentialsCheck" Content="Clear saved LM Studio credentials" />
            <Separator Margin="0,14,0,14" Background="{DynamicResource RunnerBorder}" />
            <TextBlock Text="Default model" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,0,0,5" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="ModelBox" IsEditable="True" IsTextSearchEnabled="True" MinWidth="220" />
              <Button Grid.Column="1" Content="Refresh models / test connection" Click="RefreshModels_Click" Margin="8,0,0,0" />
            </Grid>
            <TextBlock x:Name="ModelDiscoveryStatus" Text="Model discovery runs only when requested or when an inline answer starts." FontSize="10" Foreground="{DynamicResource RunnerMuted}" Margin="0,6,0,0" TextWrapping="Wrap" />
            <TextBlock Text="Thinking / reasoning" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,12,0,5" />
            <ComboBox x:Name="ThinkingBox" Width="260" HorizontalAlignment="Left"><ComboBoxItem Content="Auto" Tag="auto"/><ComboBoxItem Content="On" Tag="on"/><ComboBoxItem Content="Off" Tag="off"/><ComboBoxItem Content="Low" Tag="low"/><ComboBoxItem Content="Medium" Tag="medium"/><ComboBoxItem Content="High" Tag="high"/></ComboBox>
            <TextBlock Text="Inline system instructions · maximum 12,000 characters; empty disables the additional prompt" Foreground="{DynamicResource RunnerMuted}" FontSize="11" Margin="0,12,0,5" />
            <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="155" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Generation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="Request controls" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Keep model loaded · Ollama seconds (0–86400)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" />
              <TextBox x:Name="KeepAliveBox" Grid.Row="0" Grid.Column="1" Width="180" HorizontalAlignment="Left" />
              <TextBlock Grid.Row="1" Text="Request timeout · seconds (30–3600)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="RequestTimeoutBox" Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
              <TextBlock Grid.Row="2" Text="Model discovery timeout · seconds (1–300)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="DiscoveryTimeoutBox" Grid.Row="2" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
              <TextBlock Grid.Row="3" Text="Ollama maximum CPU threads · 0 automatic, 1–128" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="CpuThreadsBox" Grid.Row="3" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
              <TextBlock x:Name="TemperatureLabel" Grid.Row="4" Text="Temperature · optional (0–2)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="TemperatureBox" Grid.Row="4" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
              <TextBlock Grid.Row="5" Text="Top P · optional (0–1)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="TopPBox" Grid.Row="5" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
              <TextBlock Grid.Row="6" Text="Maximum output tokens · optional (1–1,000,000)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="MaxOutputTokensBox" Grid.Row="6" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
              <TextBlock Grid.Row="7" Text="Seed · optional (0–2,147,483,647)" Foreground="{DynamicResource RunnerMuted}" VerticalAlignment="Center" Margin="0,9,0,0" />
              <TextBox x:Name="SeedBox" Grid.Row="7" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,9,0,0" />
            </Grid>
            <Separator Margin="0,18,0,14" Background="{DynamicResource RunnerBorder}" />
            <TextBlock Text="Model-specific compatibility" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,7" />
            <CheckBox x:Name="NemotronModeCheck" Content="Nemotron 3.5 Bolt E4B conversational mode (LM Studio only; OFF by default)" />
            <TextBlock Text="Sends chat_template_kwargs.conversational_mode=true only for matching LM Studio model IDs on its OpenAI-compatible API. Ollama's native API does not expose this template parameter." FontSize="10" Foreground="{DynamicResource RunnerMuted}" TextWrapping="Wrap" Margin="0,5,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="4">
      <TextBlock Text="Runner settings and inline credentials are per-user and separate from the PowerToys hosts." Foreground="{DynamicResource RunnerMuted}" FontSize="10" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" />
        <Button Content="Save settings" Click="Save_Click" Background="{DynamicResource RunnerAccent}" Foreground="{DynamicResource RunnerAccentContrast}" BorderBrush="{DynamicResource RunnerAccent}" Padding="18,8" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
