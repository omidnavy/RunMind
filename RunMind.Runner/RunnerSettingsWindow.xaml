<Window x:Class="RunMind.Runner.RunnerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Runner Settings" Width="470" Height="340"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#151A24" Foreground="#E4ECF7">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="14" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Runner settings" FontSize="20" FontWeight="SemiBold" Foreground="#F0F5FC" />
      <TextBlock Text="Configure this optional launcher independently of PowerToys." FontSize="12" Foreground="#8797AD" Margin="0,6,0,0" />
    </StackPanel>

    <StackPanel Grid.Row="2">
      <TextBlock Text="Global shortcut" FontSize="12" FontWeight="SemiBold" Foreground="#BFCDE0" Margin="0,0,0,7" />
      <TextBox x:Name="HotkeyBox" Height="38" Padding="10,7" FontSize="14"
               Background="#202A39" Foreground="#EDF3FB" BorderBrush="#40516A" />
      <TextBlock Text="Examples: Ctrl+Alt+Space or Ctrl+Shift+R. The shortcut must include at least one modifier." FontSize="11" Foreground="#7F90A7" TextWrapping="Wrap" Margin="0,7,0,0" />
    </StackPanel>

    <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="4"
              Content="Start RunMind Runner when I sign in (starts minimized to the tray)"
              Foreground="#C7D3E3" FontSize="12" VerticalAlignment="Center" />

    <Grid Grid.Row="6">
      <TextBlock Text="Settings apply only to the current Windows user." Foreground="#74849A" FontSize="10" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="Cancel_Click" Padding="16,7" Margin="0,0,8,0"
                Background="#202A39" Foreground="#C9D5E5" BorderBrush="#3A485D" />
        <Button Content="Save" Click="Save_Click" Padding="18,7"
                Background="#315A8A" Foreground="White" BorderBrush="#4776AD" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
