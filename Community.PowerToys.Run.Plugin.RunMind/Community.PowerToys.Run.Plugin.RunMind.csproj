<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <UseWPF>true</UseWPF>
	<UseWindowsForms>true</UseWindowsForms>
	<RootNamespace>Community.PowerToys.Run.Plugin.RunMind</RootNamespace>
	<AssemblyName>Community.PowerToys.Run.Plugin.RunMind</AssemblyName>
	<Version>3.3.0</Version>
	<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

 

  <ItemGroup>
    <Content Include="..\Skills\**\*.*" Link="Skills\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="..\Shared\ConversationSaveDialog.cs" Link="Shared\ConversationSaveDialog.cs" />
    <Compile Include="..\Shared\WebView2RuntimeBootstrapper.cs" Link="Shared\WebView2RuntimeBootstrapper.cs" />
    <Compile Include="..\Shared\WindowLayout.cs" Link="Shared\WindowLayout.cs" />
    <Compile Include="..\Shared\AppearancePreferences.cs" Link="Shared\AppearancePreferences.cs" />
    <Compile Include="..\Shared\ThemeCatalog.cs" Link="Shared\ThemeCatalog.cs" />
    <Compile Include="..\Shared\WindowThemeSynchronizer.cs" Link="Shared\WindowThemeSynchronizer.cs" />
    <Compile Include="..\Shared\NativePageReader.cs" Link="Shared\NativePageReader.cs" />
    <Content Include="..\Shared\PlaywrightRunner.cjs" Link="PlaywrightRunner.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Shared\ApiTestRunner.cjs" Link="ApiTestRunner.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Shared\SqliteRunner.cjs" Link="SqliteRunner.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\Shared\OpenApiTestRunner.cjs" Link="OpenApiTestRunner.cjs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="..\Shared\AgentHostBridge.cs" Link="Shared\AgentHostBridge.cs" />
    <Compile Include="..\Shared\DeveloperInfrastructure.cs" Link="Shared\DeveloperInfrastructure.cs" />
    <Compile Include="..\Shared\WorkspaceFileBridge.cs" Link="Shared\WorkspaceFileBridge.cs" />
    <Compile Include="..\Shared\DevelopmentServerManager.cs" Link="Shared\DevelopmentServerManager.cs" />
    <Compile Include="..\Shared\NodeDebuggerBridge.cs" Link="Shared\NodeDebuggerBridge.cs" />
    <Compile Include="..\Shared\SystemManager.cs" Link="Shared\SystemManager.cs" />
    <Compile Include="..\Shared\InlineModelSettings.cs" Link="Shared\InlineModelSettings.cs" />
    <Reference Include="PowerToys.Common.UI">
      <HintPath>..\lib\x64\PowerToys.Common.UI.dll</HintPath>
    </Reference>
    <Reference Include="PowerToys.ManagedCommon">
      <HintPath>..\lib\x64\PowerToys.ManagedCommon.dll</HintPath>
    </Reference>
    <Reference Include="PowerToys.Settings.UI.Lib">
      <HintPath>..\lib\x64\PowerToys.Settings.UI.Lib.dll</HintPath>
    </Reference>
    <Reference Include="Wox.Infrastructure">
      <HintPath>..\lib\x64\Wox.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="Wox.Plugin">
      <HintPath>..\lib\x64\Wox.Plugin.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\Shared\ChatWindow.html">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ChatWindow.html</Link>
    </Content>
    <Content Include="..\Shared\ArtifactTools.js">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ArtifactTools.js</Link>
    </Content>
    <Content Include="..\Shared\ChatWindow\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ChatWindow\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <None Update="Images\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="..\Assets\Brand\Icon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\Brand\Icon.svg</Link>
    </Content>
    <Content Include="..\Assets\Brand\Icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Assets\Brand\Icon.ico</Link>
    </Content>
    <Content Include="..\Vendor\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Vendor\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
    <Content Include="..\OCR\tessdata\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>OCR\tessdata\%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
<PropertyGroup>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
</PropertyGroup>
</Project>
